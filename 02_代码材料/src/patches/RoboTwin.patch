+            ret = model.infer(formatted_observation) #(TASK_ENV, model, observation)
+            _c = _t.time(); _ti += _c - _b; _ni += 1
+            action, latency = ret['action'], ret['server_timing']
+            if _TE_K > 0 and len(action.shape) == 2:
+                _te_buf.append((TASK_ENV.take_action_cnt, np.asarray(action, dtype=np.float64)))
+                _te_buf = [(s0, c) for s0, c in _te_buf if s0 + len(c) > TASK_ENV.take_action_cnt]
+                for _k in range(_TE_K):
+                    _tt = TASK_ENV.take_action_cnt
+                    _p = [c[_tt - s0] for s0, c in _te_buf if s0 <= _tt < s0 + len(c)]
+                    if not _p: break
+                    _w = np.exp(-_TE_M * np.arange(len(_p)))
