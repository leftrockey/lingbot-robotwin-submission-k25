+        # lingbot competition: multi-noise consensus. LB_NOISE_K=K>1 samples K action chunks per observation
+        # (independent flow-matching noise, batched) and aggregates them with LB_NOISE_AGG=mean|median.
+        noise_k = int(os.environ.get("LB_NOISE_K", "1"))
