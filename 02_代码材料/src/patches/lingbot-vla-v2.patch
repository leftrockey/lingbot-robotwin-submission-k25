@@ -454,6 +463,12 @@ class LingbotVLAv2Server:
         )
         
         unnormalized_actions = self._unapply_batched_actions(applied, actions)
+        if noise_k > 1:
+            agg = np.median if os.environ.get("LB_NOISE_AGG", "mean") == "median" else np.mean
+            for key, value in unnormalized_actions.items():
+                unnormalized_actions[key] = agg(value.reshape(n_obs, noise_k, *value.shape[1:]), axis=1)
+            actions = actions.reshape(n_obs, noise_k, *actions.shape[1:])
